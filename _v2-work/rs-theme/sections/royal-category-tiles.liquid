{{ 'royal.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="rs-tiles" style="--rs-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign img = block.settings.image | default: c.featured_image -%}
        <a class="rs-tiles__tile" href="{{ c.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if img != blank -%}
            {{ img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 750px) 25vw, 50vw', alt: c.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="rs-tiles__label">
            {%- if block.settings.eyebrow != blank -%}<span class="rs-tiles__eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
            <h3 class="rs-tiles__title">{{ block.settings.title | default: c.title | escape }}</h3>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
{%- endstyle -%}

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "קניות לפי קטגוריה" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "default": "h2", "options": [ { "value": "h1", "label": "Large" }, { "value": "h2", "label": "Medium" }, { "value": "h3", "label": "Small" } ] },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image (defaults to collection image)" },
        { "type": "text", "id": "eyebrow", "label": "Small label above title", "default": "לנשים" },
        { "type": "text", "id": "title", "label": "Title (defaults to collection title)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [ { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" } ]
    }
  ]
}
{% endschema %}
